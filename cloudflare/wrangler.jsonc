{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-workprint-project-preview",
  "main": "src/worker.py",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": [
    "python_workers"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workprint-preview",
      "database_id": "9fad8f35-2921-45ad-b1a7-c851365773cf"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "workprint-preview-uploads"
    }
  ],
  "services": [
    {
      "binding": "AUTH_COMPAT",
      "service": "workprint-auth-compat-test"
    }
  ],
  "keep_vars": true
}
